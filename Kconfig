config ZMK_CONDITIONAL_UNDERGLOW
    bool "Conditional RGB underglow (layer + BT profile)"
    depends on ZMK_RGB_UNDERGLOW

config ZMK_CONDITIONAL_UNDERGLOW_LAYER_CENTRAL_ONLY
    bool "Apply layer-based color changes on central half only"
    depends on ZMK_CONDITIONAL_UNDERGLOW

config ZMK_CONDITIONAL_UNDERGLOW_PERIPHERAL_COUNT
    int "Number of BLE split peripherals to sync profile color to"
    default 0
    depends on ZMK_CONDITIONAL_UNDERGLOW
    depends on ZMK_SPLIT
    depends on ZMK_BLE
